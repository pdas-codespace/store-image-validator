# Copy to .env and fill in. Never commit .env. Auth is Entra ID (az login / managed identity); no keys.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Vision-capable model deployment used by --provider foundry-model (overrides .agent_configs/baseline/metadata.yaml)
MICROSOFT_FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.5
# Hosted agent name (after azd deploy) for --provider hosted-agent, cloud eval and Insights
FOUNDRY_AGENT_NAME=store-image-inspector
# Judge for Insights in Foundry (must be GPT-5 or newer)
INSIGHTS_JUDGE_MODEL=gpt-5.5
# Optional: if unset, the connection string is read from the Foundry project's connected App Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Dev only - records prompt/response content in traces. Leave off for real store images.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# Where eval images are reachable by the hosted agent (agent-target eval / optimizer)
# SIV_EVAL_IMAGE_BASE_URL=https://<storage>.blob.core.windows.net/eval-images
# SIV_EVAL_IMAGE_SAS=?<short-lived-read-only-sas>
# Hosted Blob mode: set this in the DEPLOYED agent environment, not just this file.
# Harness uses --image-auth hosted; worker identity needs Storage Blob Data Reader.
# MICROSOFT_EVAL_IMAGE_CONTAINER_URL=https://<storage>.blob.core.windows.net/eval-images
# SIV_AGENT_NAME=store-image-inspector
